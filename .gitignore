# Claves de API y archivos secretos
.groq_api_key
.env
.dev.vars
*.dev.vars

# Base de datos vectorial RAG
chroma_db/

# Entornos virtuales
.venv/
venv/
env/

# Archivos de configuración y caché de Python
__pycache__/
*.pyc

# Archivos auxiliares de LaTeX
*.aux
*.log
*.synctex.gz
*.fls
*.fdb_latexmk
*.toc
*.out
*.lof
*.lot

# Ignorar archivos y carpetas que empiecen con "examen"
examen*

# Datasets de entrenamiento LLM (datos crudos capturados — no se versionan)
datasets/

# Intermedios y artefactos de build: TODO .tmp/ es regenerable por diseño
# (AGENTS.md: "Si Python lo necesita temporalmente -> .tmp/"). Se saca la
# carpeta entera del índice; las reglas siguientes se conservan por
# documentación explícita de qué regenera cada cosa.
.tmp/

# Grabaciones de pantalla locales de docs/AGENTE_IA/ (39-41 MB cada una).
# Se conservan en el disco del autor pero fuera del repo: .git ya pesa 698 MB
# y ningun .tex/.md los referencia. Publicar un video es una decision
# consciente, no un efecto secundario de tener el fichero en la carpeta.
docs/AGENTE_IA/*.mp4

# Material de referencia de terceros descargado (papers, libros, datasheets).
# Convención completa en docs/REFERENCIA/README.md: no viaja en el clone (es
# re-descargable y pesa), RAG sí lo indexa y la auditoría (pdf_stale) lo
# excluye por ruta contándolo aparte. Se ignora TODO salvo el README, que es
# la documentación de la propia convención y sí debe viajar.
docs/REFERENCIA/**
!docs/REFERENCIA/README.md

# Dependencias de terceros instaladas: 321 MB de node_modules que `npm install`
# regenera. Versionar un node_modules congela sus vulnerabilidades y sus
# licencias: los forks se los descargan enteros y no los pueden actualizar.
node_modules/

# Build de PlatformIO (toolchains + libdeps descargados): 158 MB que
# `pio run` regenera. Solo se versiona platformio.ini, que es la declaración
# reproducible; el .pio es caché de una máquina concreta.
.pio/
compile_commands.json

# Estado/dev cache de Cloudflare Workers (wrangler)
.wrangler/

# Cachés de herramientas
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ruido de sistema operativo y editores
.DS_Store
Thumbs.db
*~
*.swp

# Caché de documentación consultada (regenerable)
.tmp/docs_cache/

# Telemetría del router LLM (log de decisiones en runtime, crece indefinidamente)
.tmp/routing_log.jsonl

# Trazas append-only de sesiones/flujos (ejecución en runtime, no se versionan)
.tmp/session_log_*.jsonl
.tmp/run_state_*.json