{
  // Worker base: ROL ROJO. Cada grupo extra vive en `env.<nombre>` con su propio
  // `name` (dominio propio en workers.dev) y sus propias vars: en wrangler los
  // `vars` NO se heredan del nivel superior, hay que repetirlos.
  "name": "cuestionarios-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "observability": { "enabled": true },
  "vars": {
    "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
    "CUESTIONARIO_ID": "rol_rojo_cuestionario",
    "GRUPOS": "4",
    "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
  },
  "env": {
    "azul": {
      "name": "cuestionarios-worker-azul",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_azul_cuestionario",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "purpura": {
      "name": "cuestionarios-worker-purpura",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_purpura_cuestionario",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "legal": {
      "name": "cuestionarios-worker-legal",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_legal_reporte_tecnico_cuestionario",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "lab1": {
      "name": "cuestionarios-worker-lab1",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados-lab1",
        "CUESTIONARIO_ID": "lab_i_fisica_cuestionario",
        "GRUPOS": "2",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "lab2": {
      "name": "cuestionarios-worker-lab2",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados-lab2",
        "CUESTIONARIO_ID": "lab_ii_fisica_cuestionario",
        "GRUPOS": "3",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    // SEMANA 02: cuatro Workers nuevos, con ID con sufijo _s2 para no compartir
    // clave ni carpeta de resultados con SEMANA_01. El repo de resultados puede
    // ser el mismo porque rutaResultado() prefija el `cuestionario` a la ruta.
    "s2": {
      "name": "cuestionarios-worker-s2",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_rojo_cuestionario_s2",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "s2_azul": {
      "name": "cuestionarios-worker-s2-azul",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_azul_cuestionario_s2",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "s2_purpura": {
      "name": "cuestionarios-worker-s2-purpura",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_purpura_cuestionario_s2",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    },
    "s2_legal": {
      "name": "cuestionarios-worker-s2-legal",
      "vars": {
        "REPO_RESULTADOS": "cero97-ctrl/cuestionarios-resultados",
        "CUESTIONARIO_ID": "rol_legal_cuestionario_s2",
        "GRUPOS": "4",
        "ORIGENES": "https://cero97-ctrl.github.io,http://localhost:8788"
      }
    }
  }
}
